        "type": "text/javascript",
        "exec": [
          "// Auto-inject Bearer token if available",
          "const token = pm.collectionVariables.get(\"accessToken\");",
          "",
          "if (token) {",
          "  pm.request.headers.add({",
          "    key: \"Authorization\",",
          "    value: \"Bearer \" + token",
          "  });",
          "}"
        ]
      }
    },
